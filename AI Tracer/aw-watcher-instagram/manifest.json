{
  "manifest_version": 3,
  "name": "AI Tracer - Instagram Watcher",
  "version": "2.0",
  "description": "Tracks Instagram activity for personal productivity analysis",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.instagram.com/*", "http://localhost:5050/*", "http://127.0.0.1:5050/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
